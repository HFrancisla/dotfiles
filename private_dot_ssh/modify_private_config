#!/bin/sh
set -eu

marker='# dotfiles: shared SSH defaults'
include_line='Include ~/.ssh/config.d/10-dotfiles.conf'

# 仅删除旧版本精确生成的 Host * 段；任何改动都视为用户配置并保留。
awk '
    function trim(value) {
        sub(/^[[:space:]]+/, "", value)
        sub(/[[:space:]]+$/, "", value)
        return value
    }

    function flush(    i, n, normalized, legacy) {
        if (!buffering) {
            return
        }

        n = 0
        delete actual
        for (i = 1; i <= count; i++) {
            normalized = trim(buffer[i])
            if (normalized != "") {
                actual[++n] = normalized
            }
        }

        legacy = n == 7 &&
            actual[1] == "Host *" &&
            actual[2] == "ServerAliveInterval 60" &&
            actual[3] == "ServerAliveCountMax 3" &&
            actual[4] == "AddKeysToAgent yes" &&
            actual[5] == "ControlMaster auto" &&
            actual[6] == "ControlPath ~/.ssh/sockets/%r@%h-%p" &&
            actual[7] == "ControlPersist 10m"

        if (!legacy) {
            for (i = 1; i <= count; i++) {
                print buffer[i]
            }
        }

        delete buffer
        count = 0
        buffering = 0
    }

    {
        normalized = trim($0)

        if (normalized ~ /^(Host|Match)[[:space:]]+/) {
            flush()
            if (normalized == "Host *") {
                buffering = 1
                buffer[++count] = $0
                next
            }
        }

        if (buffering) {
            buffer[++count] = $0
            next
        }

        print
    }

    END {
        flush()
    }
' |
# 删除旧托管块和重复 Include，最后追加唯一托管块。
awk -v marker="$marker" -v inc="$include_line" '
    function trim(value) {
        sub(/^[[:space:]]+/, "", value)
        sub(/[[:space:]]+$/, "", value)
        return value
    }

    function emit(line, normalized_line) {
        if (normalized_line == "") {
            blanks = blanks line ORS
            return
        }

        printf "%s", blanks
        blanks = ""
        print line
        wrote = 1
    }

    {
        normalized = trim($0)

        if (normalized == marker) {
            state = 1
            managed_blanks = ""
            next
        }

        if (state == 1 && normalized == "") {
            next
        }

        if (state == 1 && normalized == "Host *") {
            state = 2
            next
        }

        if (state == 1) {
            state = 0
        }

        if (state == 2 && normalized == "") {
            managed_blanks = managed_blanks $0 ORS
            next
        }

        if (state == 2 && normalized == inc) {
            state = 0
            managed_blanks = ""
            next
        }

        if (state == 2) {
            # 不完整托管块保留 Host 上下文，避免改变后续指令语义。
            emit("Host *", "Host *")
            blanks = blanks managed_blanks
            state = 0
            managed_blanks = ""
        }

        # Include 由 dotfiles 管理，统一去重。
        if (normalized == inc) {
            next
        }

        emit($0, normalized)
    }

    END {
        # 丢弃尾部空行，并在托管块前保留一个空行。
        if (wrote) {
            print ""
        }
        print marker
        print "Host *"
        print inc
    }
'
