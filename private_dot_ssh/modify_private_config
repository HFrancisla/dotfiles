#!/bin/sh
set -eu

marker='# dotfiles: shared SSH defaults'
include_line='Include ~/.ssh/config.d/10-dotfiles.conf'

# chezmoi passes the current ~/.ssh/config on stdin and uses stdout as the
# desired file content. First remove the exact legacy Host * stanza that older
# versions of these dotfiles owned as a whole file. The match is deliberately
# strict: any added directive or changed value means the stanza is user-owned
# and must be preserved.
awk '
    function trim(value) {
        sub(/^[[:space:]]+/, "", value)
        sub(/[[:space:]]+$/, "", value)
        return value
    }

    function flush(    i, n, normalized, legacy) {
        if (!buffering) {
            return
        }

        n = 0
        delete actual
        for (i = 1; i <= count; i++) {
            normalized = trim(buffer[i])
            if (normalized != "") {
                actual[++n] = normalized
            }
        }

        legacy = n == 7 &&
            actual[1] == "Host *" &&
            actual[2] == "ServerAliveInterval 60" &&
            actual[3] == "ServerAliveCountMax 3" &&
            actual[4] == "AddKeysToAgent yes" &&
            actual[5] == "ControlMaster auto" &&
            actual[6] == "ControlPath ~/.ssh/sockets/%r@%h-%p" &&
            actual[7] == "ControlPersist 10m"

        if (!legacy) {
            for (i = 1; i <= count; i++) {
                print buffer[i]
            }
        }

        delete buffer
        count = 0
        buffering = 0
    }

    {
        normalized = trim($0)

        if (normalized ~ /^(Host|Match)[[:space:]]+/) {
            flush()
            if (normalized == "Host *") {
                buffering = 1
                buffer[++count] = $0
                next
            }
        }

        if (buffering) {
            buffer[++count] = $0
            next
        }

        print
    }

    END {
        flush()
    }
' |
# Then keep every unrelated stanza, remove any previous dotfiles-owned managed
# block, trim only trailing blank lines, and append one canonical block at EOF.
awk -v marker="$marker" -v inc="$include_line" '
    function trim(value) {
        sub(/^[[:space:]]+/, "", value)
        sub(/[[:space:]]+$/, "", value)
        return value
    }

    function emit(line, normalized_line) {
        if (normalized_line == "") {
            blanks = blanks line ORS
            return
        }

        printf "%s", blanks
        blanks = ""
        print line
        wrote = 1
    }

    {
        normalized = trim($0)

        if (normalized == marker) {
            state = 1
            managed_blanks = ""
            next
        }

        if (state == 1 && normalized == "") {
            next
        }

        if (state == 1 && normalized == "Host *") {
            state = 2
            next
        }

        if (state == 1) {
            state = 0
        }

        if (state == 2 && normalized == "") {
            managed_blanks = managed_blanks $0 ORS
            next
        }

        if (state == 2 && normalized == inc) {
            state = 0
            managed_blanks = ""
            next
        }

        if (state == 2) {
            # A marker followed by Host * but not by the managed Include is a
            # damaged/edited block. Preserve that Host context so unexpected
            # user directives do not silently change meaning.
            emit("Host *", "Host *")
            blanks = blanks managed_blanks
            state = 0
            managed_blanks = ""
        }

        # The Include path itself is owned by dotfiles, so collapse duplicates
        # even if the marker was manually removed.
        if (normalized == inc) {
            next
        }

        emit($0, normalized)
    }

    END {
        # Intentionally discard pending trailing blank lines and normalize the
        # separator before the managed block to exactly one empty line.
        if (wrote) {
            print ""
        }
        print marker
        print "Host *"
        print inc
    }
'
