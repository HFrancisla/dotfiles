# 保留 init 时实际使用的 source，避免维护第二份仓库副本。
sourceDir = {{ .chezmoi.sourceDir | quote }}

[diff]
    pager = "diff-so-fancy | less --tabs=4 -RFX"

[update]
    apply = true

[data]
    name  = {{ promptStringOnce . "name" "Git 提交者姓名" | quote }}
    email = {{ promptStringOnce . "email" "Git 提交者邮箱" | quote }}
