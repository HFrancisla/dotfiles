# vi: ft=dosini

[main]
completer_max = 300
completion_casing = auto
newbie_mode = False
raw = False
decode = utf-8

enable_pager = True
pager = less -SRXF

prompt = {host}:{port}[{db}]>
rainbow = False

retry_times = 2
socket_keepalive = True

# 允许在 REPL 中执行 shell 命令。
shell = True

[alias_dsn]
# local = redis://localhost:6379/0
