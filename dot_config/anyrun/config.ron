Config(
    x: Fraction(0.5),
    y: Absolute(0),
    width: Fraction(0.45),
    // 1px 可让结果窗口扩展后重新收缩；0 会只增不减。
    height: Absolute(1),

    hide_icons: false,
    hide_plugin_info: false,
    ignore_exclusive_zones: false,
    layer: Overlay,

    close_on_click: true,
    // 剪贴板 stdin 调用需要立即展示输入。
    show_results_immediately: true,
    max_entries: None,

    plugins: [
        "libapplications.so",
        "libshell.so",
    ],
)
