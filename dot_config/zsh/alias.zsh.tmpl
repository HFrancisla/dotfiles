    alias makepkg='PATH=/usr/bin:$PATH makepkg'
    alias yayin='yay -S --needed'
fi

# MATLAB
mrun() {
    if [[ $# -ne 1 ]]; then
        echo "Usage: mrun <command>"
        return 1
    fi
    local current_time=$(date +%Y_%m_%d-%H_%M_%S)
    local log_file="${current_time}.log"
    echo "Starting MATLAB. Logging to: $log_file"

    local matlab_cmd
    if grep -qEi '(Microsoft|WSL)' /proc/version 2>/dev/null; then
        matlab_cmd="matlab.exe"
    else
        matlab_cmd="matlab"
    fi

    if ! command -v "$matlab_cmd" &>/dev/null; then
        echo "Error: $matlab_cmd not found in PATH" >&2
        return 1
    fi

    "$matlab_cmd" -nodesktop -nosplash -logfile "$log_file" -r "$1"
}

# Git
alias gcl1="git clone --depth=1"
alias gundo="git reset HEAD~1 --mixed"
# 先展示影响范围，必须明确确认；不删除 ignored 文件。
unalias gnuke 2>/dev/null || true
gnuke() {
    local root reply
    root=$(git rev-parse --show-toplevel) || return
    git -C "$root" status --short --untracked-files=all || return
    git -C "$root" clean -nd || return
    read -q "reply?确认丢弃 $root 中所有未提交修改？[y/N] " || { print; return 1; }
    print
    git -C "$root" reset --hard && git -C "$root" clean -df
}
alias gtree="git log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all"

fgb() {
  local branch
  branch=$(git branch -a --format='%(refname:short)' |
    grep -v '/HEAD$' | sort |
    fzf --tac --preview-window right:70% \
        --preview 'git log --oneline --graph --date=short --color=always --pretty="format:%C(auto)%cd %h%d %s" {}')
  [[ -n "$branch" ]] || return 0

  if git show-ref --verify --quiet "refs/heads/$branch"; then
    git switch "$branch"
  else
    git switch --track "$branch"
  fi
}

# Python
uvact() {
    local dir="$PWD"
    while [[ "$dir" != "/" ]]; do
        if [[ -f "$dir/.venv/bin/activate" ]]; then
            source "$dir/.venv/bin/activate"
            return 0
        fi
        dir="$(dirname "$dir")"
    done
    echo "No .venv found in parent directories" >&2
    return 1
}

