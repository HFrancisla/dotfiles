# ==============================================================================
# 用户自定义别名 (Aliases) & 增强函数 (Functions)
# ==============================================================================

# -------------------- 1. 基础系统与配置文件 --------------------
alias vim="nvim"
alias zshcfg="chezmoi edit ~/.config/zsh/.zshrc"      # 快速编辑 zsh 主配置
alias aliascfg="chezmoi edit ~/.config/zsh/alias.zsh" # 快速编辑此别名文件
alias reload="source \$ZDOTDIR/.zshrc && echo 'Zsh config reloaded!'" 

# -------------------- 2. 现代工具集成 --------------------
# eza: 下一代 ls (Rust 编写)
alias ls="eza --classify --icons=always --color-scale --group-directories-first --time-style iso"
alias ll="ls --long --header --links --group"
alias la="ls -a"
alias cat="bat --paging=never"
alias grep="grep --color=auto"

# ==========================================
# Zsh 后缀别名配置 (Suffix Aliases)
# ==========================================
# 代码与文本文件：绑定到默认编辑器
alias -s {txt,md,json,yaml,yml,conf,ini}="$EDITOR"
alias -s {c,cpp,py,js,ts,go,java,html,css}="$EDITOR"
# 压缩包查看：直接输入压缩包名，即可列出内容（而不是直接解压，更安全）
alias -s zip="unzip -l"
alias -s {tar,tar.gz,tgz}="tar -tvf"

# -------------------- 3. 包管理器 (Arch Linux / yay) --------------------
if command -v pacman &> /dev/null; then
    alias pacin='sudo pacman -S --needed'     # 仅安装缺失包
    alias pacup='sudo pacman -Syu'            # 系统更新
fi

if command -v yay &> /dev/null; then
    # PATH=/usr/bin 前置：防止 mise/linuxbrew 等遮蔽系统 Python 导致 AUR 构建失败
    alias yay='PATH=/usr/bin:$PATH yay'
    alias makepkg='PATH=/usr/bin:$PATH makepkg'
    alias yayin='yay -S --needed'
fi

# -------------------- 4. 专属业务函数 (MATLAB) --------------------
# mrun: 启动 MATLAB 并按当前时间生成独立日志文件
mrun() {
    if [[ $# -eq 0 ]]; then
        echo "Usage: mrun <script_name>"
        return 1
    fi
    local current_time=$(date +%Y_%m_%d-%H_%M_%S)
    local log_file="${current_time}.log"
    echo "Starting MATLAB. Logging to: $log_file"

    # 自动检测 MATLAB 命令 (WSL 使用 matlab.exe，原生 Linux 使用 matlab)
    local matlab_cmd
    if grep -qEi '(Microsoft|WSL)' /proc/version 2>/dev/null; then
        matlab_cmd="matlab.exe"
    else
        matlab_cmd="matlab"
    fi

    if ! command -v "$matlab_cmd" &>/dev/null; then
        echo "Error: $matlab_cmd not found in PATH" >&2
        return 1
    fi

    "$matlab_cmd" -nodesktop -nosplash -logfile "$log_file" -r "$@"
}

# -------------------- 5. 高阶 Git 扩展 --------------------
# 基础操作 (OMZ git 插件已提供 gst, gco, ga, gcmsg 等)
alias gcl1="git clone --depth=1"              # 浅克隆：仅拉取最新一次提交 (加速查看开源代码)
alias gundo="git reset HEAD~1 --mixed"        # 撤销提交，保留代码
alias gnuke="git clean -df && git reset --hard" # 强制毁灭性重置 (慎用)
alias gtree="git log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all"

# fgb: 交互式切换分支 (基于 fzf)
fgb() {
  local branch
  branch=$(git branch -a --color=always | grep -v '/HEAD\s' | sort |
    fzf --ansi --multi --tac --preview-window right:70% \
        --preview 'git log --oneline --graph --date=short --color=always --pretty="format:%C(auto)%cd %h%d %s" $(sed s/^..// <<< {} | cut -d" " -f1)' |
    sed 's/^..//' | cut -d' ' -f1 | sed 's#^remotes/##')
  [[ -n "$branch" ]] && git checkout "$branch"
}

# -------------------- 6. Python uv 虚拟环境 --------------------
# uvact: 向上查找 .venv 并激活
uvact() {
    local dir="$PWD"
    while [[ "$dir" != "/" ]]; do
        if [[ -f "$dir/.venv/bin/activate" ]]; then
            source "$dir/.venv/bin/activate"
            return 0
        fi
        dir="$(dirname "$dir")"
    done
    echo "No .venv found in parent directories" >&2
    return 1
}

# -------------------- 7. 容器化工具 (Docker) --------------------
if command -v docker &> /dev/null; then
    # 格式化列表：ID | 容器名 | 状态 | 镜像
    alias dps="docker ps --format 'table {{ "{{.ID}}" }}\t{{ "{{.Names}}" }}\t{{ "{{.Status}}" }}\t{{ "{{.Image}}" }}'"
    alias dstopall="docker stop \$(docker ps -q)"
    alias dprune="docker system prune -a -f --volumes" # 清理所有冗余
    
    # fdex: 交互式进入容器终端
    fdex() {
        local container
        container=$(docker ps --format '{{ "{{.Names}}" }}' | fzf --height 40% --reverse --prompt="Select container: ")
        if [[ -n "$container" ]]; then
            docker exec -it "$container" bash || docker exec -it "$container" sh
        fi
    }
fi

