# 文件导航
cdf() {
    local search_dir="${1:-.}"
    local file
    file=$(fd --type f . "$search_dir" | fzf --preview 'bat --color=always {}') || return
    cd "$(dirname "$file")"
}

# gpall
# 批量快进有 upstream 且工作区干净的仓库。
#   gpall              起点是仓库时只处理自身；否则扫描下一层
#   gpall -n 2         向下递归 2 层（-n 0 = 只处理起点目录自身）
#   gpall --all        递归全部层级
#   gpall <dir>...     指定起点
#
# 命中仓库后停止下潜；pull 固定使用 --ff-only --no-rebase --no-autostash --prune。
# 退出码：0 = 没有仓库失败（含一个都没找到）；1 = 有仓库拉取失败；2 = 参数错误

_gpall_pruned=".git node_modules .venv venv .direnv target vendor dist build .cache .next .tox __pycache__ .mypy_cache .pytest_cache .ruff_cache site-packages"

_gpall_walk() {
    local dir="$1" depth="$2" max="$3" sub base
    (( depth > max )) && return 0
    for sub in "$dir"/*(N/) "$dir"/.[!.]*(N/); do
        [[ -L "$sub" ]] && continue
        base="${sub:t}"
        [[ " $_gpall_pruned " == *" $base "* ]] && continue
        if [[ -e "$sub/.git" ]]; then
            print -r -- "${sub:A}"
        else
            _gpall_walk "$sub" $(( depth + 1 )) "$max"
        fi
    done
}

gpall() {
    emulate -L zsh
    setopt local_options no_aliases

    local -a roots=() repos=() disp=() branches=() branch_states=() branch_errors=() hints=() parts=()
    local max_depth=1

    while (( $# )); do
        case "$1" in
            -n)     if (( $# < 2 )); then print -u2 "gpall: -n 需要一个非负整数"; return 2; fi; shift; max_depth="$1" ;;
            -n<->)  max_depth="${1#-n}" ;;
            --all)  max_depth=999 ;;
            --)     shift; roots+=( "$@" ); break ;;
            -*)     print -u2 "gpall: 未知选项 '$1'（用法: gpall [-n 层级|--all] [目录...]）"; return 2 ;;
            *)      roots+=( "$1" ) ;;
        esac
        shift
    done

    if [[ "$max_depth" != <-> ]]; then
        print -u2 "gpall: -n 需要一个非负整数（用法: gpall [-n 层级|--all] [目录...]）"
        return 2
    fi
    (( ${#roots} )) || roots=( . )

    local base="${PWD:A}"
    local -a places=()
    local root found
    for root in "${roots[@]}"; do
        if [[ ! -d "$root" ]]; then
            print -u2 "gpall: 目录不存在，已忽略: $root"
            continue
        fi
        root="${root:A}"
        if   [[ "$root" == "$base" ]];   then places+=( "." )
        elif [[ "$root" == "$base"/* ]]; then places+=( "${root#"$base"/}" )
        else                                   places+=( "$root" ); fi
        if [[ -e "$root/.git" ]]; then
            repos+=( "$root" )
            continue
        fi
        found="$(_gpall_walk "$root" 1 "$max_depth")"
        [[ -n "$found" ]] && repos+=( "${(@f)found}" )
    done
    places=( "${(ou)places[@]}" )
    repos=( "${(ou)repos[@]}" )

    if (( ${#repos} == 0 )); then
        print -u2 "gpall: 没有找到任何 git 仓库"
        return 0
    fi

    local p b branch_output branch_rc w=4 bw=6
    for p in "${repos[@]}"; do
        if   [[ "$p" == "$base" ]];   then disp+=( "." )
        elif [[ "$p" == "$base"/* ]]; then disp+=( "${p#"$base"/}" )
        else                                disp+=( "$p" ); fi
        branch_output="$(git -C "$p" symbolic-ref --quiet --short HEAD 2>&1)"
        branch_rc=$?
        if (( branch_rc == 0 )); then
            b="$branch_output"
            branch_states+=( BRANCH )
            branch_errors+=( '' )
        elif (( branch_rc == 1 )); then
            b="(detached)"
            branch_states+=( DETACHED )
            branch_errors+=( '' )
        else
            b="(git error)"
            branch_states+=( ERROR )
            branch_errors+=( "$branch_output" )
        fi
        branches+=( "$b" )
    done
    for p in "${disp[@]}";     do (( ${#p} > w ))  && w=${#p};  done
    for b in "${branches[@]}"; do (( ${#b} > bw )) && bw=${#b}; done

    local c_rst='' c_bld='' c_dim='' c_red='' c_grn='' c_ylw=''
    if [[ -t 1 && -z "${NO_COLOR-}" && "${TERM-}" != dumb ]]; then
        c_rst=$'\e[0m'; c_bld=$'\e[1m'; c_dim=$'\e[2m'
        c_red=$'\e[31m'; c_grn=$'\e[32m'; c_ylw=$'\e[33m'
    fi

    print -r -- "${c_bld}gpall${c_rst} ${c_dim}· 扫描 ${(j:, :)places} · 命中 ${#repos} 个仓库${c_rst}"
    print
    printf '%s%-*s  %-*s  %s%s\n' "$c_dim" "$w" "REPO" "$bw" "BRANCH" "RESULT" "$c_rst"

    local idx repo branch before after out state color text detail worktree_status remote_list
    local n_upd=0 n_clean=0 n_skip=0 n_fail=0

    for idx in {1..${#repos[@]}}; do
        repo="${repos[idx]}"
        branch="${branches[idx]}"
        state='' detail=''

        if [[ "${branch_states[idx]}" == DETACHED ]]; then
            state=SKIP_DETACHED
        elif [[ "${branch_states[idx]}" == ERROR ]]; then
            state=FAILED
            detail="cannot inspect HEAD: ${branch_errors[idx]%%$'\n'*}"
        elif ! git -C "$repo" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
            if ! remote_list="$(git -C "$repo" remote 2>&1)"; then
                state=FAILED; detail="${remote_list%%$'\n'*}"
            elif [[ -z "$remote_list" ]]; then state=SKIP_NO_REMOTE
            else state=SKIP_NO_UPSTREAM; fi
        elif ! worktree_status="$(git -C "$repo" status --porcelain --untracked-files=all --ignore-submodules=none 2>&1)"; then
            state=FAILED; detail="${worktree_status%%$'\n'*}"
        elif [[ -n "$worktree_status" ]]; then
            state=SKIP_DIRTY
        else
            before="$(git -C "$repo" rev-parse HEAD 2>/dev/null)"
            if out="$(LC_ALL=C GIT_TERMINAL_PROMPT=0 git -C "$repo" pull --no-rebase --no-autostash --ff-only --prune 2>&1)"; then
                after="$(git -C "$repo" rev-parse HEAD 2>/dev/null)"
                if [[ "$before" != "$after" ]]; then
                    state=UPDATED
                    detail="+$(git -C "$repo" rev-list --count "$before..$after")"
                else
                    if detail="$(git -C "$repo" rev-list --count '@{u}..HEAD' 2>&1)"; then
                        if (( detail > 0 )); then state=AHEAD; else state=UPTODATE; fi
                    else
                        state=FAILED; detail="${detail%%$'\n'*}"
                    fi
                fi
            elif [[ "$out" == *"Not possible to fast-forward"* || "$out" == *"diverged"* ]]; then
                state=DIVERGED
            else
                state=FAILED; detail="${out%%$'\n'*}"
            fi
        fi

        case "$state" in
            UPDATED)          color="$c_grn"; text="✓ updated ${detail} commits" ;;
            UPTODATE)         color="$c_dim"; text="✓ already up to date" ;;
            AHEAD)            color="$c_ylw"; text="⚠ local branch ahead by ${detail} commits" ;;
            SKIP_DIRTY)       color="$c_ylw"; text="⚠ skipped: uncommitted changes" ;;
            SKIP_DETACHED)    color="$c_ylw"; text="⚠ skipped: detached HEAD" ;;
            SKIP_NO_UPSTREAM) color="$c_ylw"; text="⚠ skipped: no upstream branch" ;;
            SKIP_NO_REMOTE)   color="$c_ylw"; text="⚠ skipped: no remote configured" ;;
            DIVERGED)         color="$c_red"; text="✗ diverged from upstream" ;;
            FAILED)           color="$c_red"; text="✗ failed: ${detail}" ;;
            *)                color="$c_red"; text="✗ unknown state" ;;
        esac

        printf '%s%-*s%s  %-*s  %s%s%s\n' "$c_bld" "$w" "${disp[idx]}" "$c_rst" "$bw" "$branch" "$color" "$text" "$c_rst"

        case "$state" in
            UPDATED)          (( n_upd += 1 )) ;;
            UPTODATE)         (( n_clean += 1 )) ;;
            AHEAD)            (( n_skip += 1 )); hints+=( "${disp[idx]}: 本地领先上游，确认后推送" ) ;;
            SKIP_DIRTY)       (( n_skip += 1 )); hints+=( "${disp[idx]}: 有未提交改动 → git -C '${disp[idx]}' status（处理完可重跑 gpall）" ) ;;
            SKIP_DETACHED)    (( n_skip += 1 )); hints+=( "${disp[idx]}: 游离 HEAD → git -C '${disp[idx]}' log -1 --oneline --decorate，核对提交后再切换到目标分支" ) ;;
            SKIP_NO_UPSTREAM) (( n_skip += 1 )); hints+=( "${disp[idx]}: 没有上游分支 → git -C '${disp[idx]}' branch -vv，核对远端分支后再设置 upstream" ) ;;
            SKIP_NO_REMOTE)   (( n_skip += 1 )); hints+=( "${disp[idx]}: 没有配置任何远端 → git -C '${disp[idx]}' remote add origin <url>" ) ;;
            DIVERGED)         (( n_fail += 1 )); hints+=( "${disp[idx]}: 与上游分叉 → git -C '${disp[idx]}' log --oneline --left-right --graph '@{u}...HEAD'" ) ;;
            FAILED)           (( n_fail += 1 )); hints+=( "${disp[idx]}: ${detail}" ) ;;
        esac
    done

    print
    (( n_upd ))   && parts+=( "${c_grn}${n_upd} 个已更新${c_rst}" )
    (( n_clean )) && parts+=( "${c_dim}${n_clean} 个已是最新${c_rst}" )
    (( n_skip ))  && parts+=( "${c_ylw}${n_skip} 个已跳过${c_rst}" )
    (( n_fail ))  && parts+=( "${c_red}${n_fail} 个失败${c_rst}" )
    print -r -- "${c_bld}共 ${#repos} 个仓库${c_rst} ${(j: · :)parts}"

    if (( ${#hints} )); then
        print
        print -r -- "${c_dim}需要你手动处理的:${c_rst}"
        for p in "${hints[@]}"; do print -r -- "  · $p"; done
    fi

    (( n_fail > 0 )) && return 1
    return 0
}

# AGY
# 默认保留工具审批；如有需要由调用者显式传入 --dangerously-skip-permissions。
# Profile 只隔离配置和凭据，不限制文件访问。
unalias agy agy1 agy2 2>/dev/null || true

agy() {
    command agy "$@"
}

_agy_profile() {
    local profile_name="$1"
    shift
    local agy_bin profile_dir
    agy_bin="$(whence -p agy)" || {
        print -u2 -- "未找到 AGY，请先安装 agy"
        return 127
    }
    command -v bwrap >/dev/null 2>&1 || {
        print -u2 -- "未找到 Bubblewrap，请先安装 bubblewrap"
        return 127
    }
    profile_dir="$HOME/.agy-profiles/$profile_name/.gemini"

    (
        umask 077
        mkdir -p -- "$profile_dir" "$HOME/.gemini" || exit 1
        unset GEMINI_HOME GEMINI_API_KEY AGY_ADC_AUTH

        command bwrap \
            --bind / / \
            --dev-bind /dev /dev \
            --bind "$profile_dir" "$HOME/.gemini" \
            --unsetenv DBUS_SESSION_BUS_ADDRESS \
            --chdir "$PWD" \
            -- "$agy_bin" "$@"
    )
}

agy1() {
    _agy_profile account1 "$@"
}

agy2() {
    _agy_profile account2 "$@"
}
