# ~/.config/zsh/.zprofile

# 仅 Arch 桌面在 tty1 自动进入 Hyprland；Ubuntu/WSL 等环境不会误启动。
if [ -r /etc/os-release ]; then
    . /etc/os-release
fi

if [ "${ID:-}" = "arch" ] &&
   command -v start-hyprland >/dev/null 2>&1 &&
   [ -z "${WAYLAND_DISPLAY:-}" ] &&
   [ "${XDG_VTNR:-0}" -eq 1 ]; then
    exec start-hyprland
fi
