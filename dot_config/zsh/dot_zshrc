export HISTSIZE=10000
export SAVEHIST=10000
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_REDUCE_BLANKS
setopt SHARE_HISTORY

CASE_SENSITIVE="true"
HIST_STAMPS="yyyy-mm-dd"

if [ -f "$ZSH/oh-my-zsh.sh" ]; then
    source "$ZSH/oh-my-zsh.sh"
fi

if [ -f "$ZSH_AUTOSUGGESTIONS_FILE" ]; then
    source "$ZSH_AUTOSUGGESTIONS_FILE"
fi

# 交互行为与函数
unsetopt beep
bindkey -e

if [ -f "$ZDOTDIR/alias.zsh" ]; then
    source "$ZDOTDIR/alias.zsh"
fi

rfv() {
  local RELOAD='reload:rg --column --color=always --smart-case {q} || :'
  local OPENER='if [[ $FZF_SELECT_COUNT -eq 0 ]]; then
                  nvim {1} +{2}
                else
                  nvim +cw -q {+f}
                fi'
  fzf --disabled --ansi --multi \
      --bind "start:$RELOAD" --bind "change:$RELOAD" \
      --bind "enter:become:$OPENER" \
      --bind "ctrl-o:execute:$OPENER" \
      --bind 'alt-a:select-all,alt-d:deselect-all,ctrl-/:toggle-preview' \
      --delimiter : \
      --preview "bat --style=full --color=always --highlight-line {2} {1}" \
      --preview-window '~4,+{2}+4/3,<80(up)' \
      --query "$*"
}

y() {
    local tmp cwd yazi_status
    tmp="$(mktemp -t "yazi-cwd.XXXXXX")" || return
    command yazi "$@" --cwd-file="$tmp"
    yazi_status=$?
    cwd="$(command cat -- "$tmp" 2>/dev/null)"
    command rm -f -- "$tmp"
    if [ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && [ -d "$cwd" ]; then
        builtin cd -- "$cwd"
    fi
    return "$yazi_status"
}

# WSL mirrored 使用回环，NAT 使用默认网关；也可显式传入地址。
proxy() {
    local host_ip="${1:-}" mode
    if [[ -z "$host_ip" ]]; then
        if command grep -qiE '(Microsoft|WSL)' /proc/version 2>/dev/null; then
            mode=$(wslinfo --networking-mode 2>/dev/null) || mode=unknown
            case "$mode" in
                mirrored) host_ip=127.0.0.1 ;;
                nat|virtioproxy|unknown)
                    host_ip=$(ip -4 route show default | awk '$1 == "default" && $2 == "via" {print $3; exit}')
                    ;;
                *) print -u2 "无法自动识别 WSL 网络模式: $mode，请使用 proxy <host>"; return 1 ;;
            esac
        else
            host_ip=127.0.0.1
        fi
    fi
    if [[ -z "$host_ip" || "$host_ip" == *[[:space:]/]* ]]; then
        print -u2 "无法确定代理地址，请使用 proxy <host>"
        return 1
    fi
    export http_proxy="http://${host_ip}:7890" https_proxy="http://${host_ip}:7890"
    export all_proxy="socks5h://${host_ip}:7890"
    export HTTP_PROXY="$http_proxy" HTTPS_PROXY="$https_proxy" ALL_PROXY="$all_proxy"
    print -r -- "Proxy has been set to: ${host_ip}:7890"
}

unproxy() {
    unset https_proxy http_proxy all_proxy HTTPS_PROXY HTTP_PROXY ALL_PROXY
    print -r -- "Proxies have been unset."
}

conda-mirror() {
  local mirror_dir="${XDG_CONFIG_HOME:-$HOME/.config}/conda"
  case "$1" in
    nju)   export CONDARC="$mirror_dir/.condarc_nju"   ;;
    tsing) export CONDARC="$mirror_dir/.condarc_tsing" ;;
    off)   unset CONDARC; echo "CONDARC unset (using default ~/.condarc)"; return ;;
    *)
      echo "Usage: conda-mirror <nju|tsing|off>"
      echo "  nju   - 南京大学镜像"
      echo "  tsing - 清华大学镜像"
      echo "  off   - 取消, 使用默认 ~/.condarc"
      [ -n "$CONDARC" ] && echo "Current: $CONDARC" || echo "Current: (default)"
      return ;;
  esac
  echo "CONDARC set to: $CONDARC"
}

