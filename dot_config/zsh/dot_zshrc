# --- 自定义函数 (Functions) ---

# ripgrep -> fzf -> vim
rfv() {
  local RELOAD='reload:rg --column --color=always --smart-case {q} || :'
  local OPENER='if [[ $FZF_SELECT_COUNT -eq 0 ]]; then
                  nvim {1} +{2}
                else
                  nvim +cw -q {+f}
                fi'
  # 预览使用统一的 bat 命令
  fzf --disabled --ansi --multi \
      --bind "start:$RELOAD" --bind "change:$RELOAD" \
      --bind "enter:become:$OPENER" \
      --bind "ctrl-o:execute:$OPENER" \
      --bind 'alt-a:select-all,alt-d:deselect-all,ctrl-/:toggle-preview' \
      --delimiter : \
      --preview "bat --style=full --color=always --highlight-line {2} {1}" \
      --preview-window '~4,+{2}+4/3,<80(up)' \
      --query "$*"
}

# yazi 集成
y() {
    local tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
    yazi "$@" --cwd-file="$tmp"
    if local cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
        builtin cd -- "$cwd"
    fi
    command rm -f -- "$tmp"
}

# 代理函数 (跨平台/WSL兼容优化)
proxy() {
  local host_ip
  # 检测是否处于 WSL 环境
  if grep -qE "(Microsoft|WSL)" /proc/version &> /dev/null; then
    # 提取 WSL 宿主机 IP
    host_ip=$(awk '/^nameserver/{print $2; exit}' /etc/resolv.conf)
  else
    # 物理机或 macOS 直接走本地回环
    host_ip="127.0.0.1"
  fi

  export https_proxy="http://${host_ip}:7890"
  export http_proxy="http://${host_ip}:7890"
  export all_proxy="socks5://${host_ip}:7890"
  echo "Proxy has been set to: ${host_ip}:7890"
}

unproxy() {
  unset https_proxy http_proxy all_proxy
  echo "Proxies have been unset."
}

# conda 镜像切换 (通过 CONDARC 环境变量)
conda-mirror() {
  local mirror_dir="${XDG_CONFIG_HOME:-$HOME/.config}/conda"
  case "$1" in
    nju)   export CONDARC="$mirror_dir/.condarc_nju"   ;;
    tsing) export CONDARC="$mirror_dir/.condarc_tsing" ;;
    off)   unset CONDARC; echo "CONDARC unset (using default ~/.condarc)"; return ;;
    *)
      echo "Usage: conda-mirror <nju|tsing|off>"
      echo "  nju   - 南京大学镜像"
      echo "  tsing - 清华大学镜像"
      echo "  off   - 取消, 使用默认 ~/.condarc"
      [ -n "$CONDARC" ] && echo "Current: $CONDARC" || echo "Current: (default)"
      return ;;
  esac
  echo "CONDARC set to: $CONDARC"
}

