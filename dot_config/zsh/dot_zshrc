# -------------------- 1. 环境变量 (Environment Variables) --------------------
# 大多数的静态环境变量已经放到了~/.zshenv下
# Intel 集成显卡专用：自动检测是否存在 Intel 显卡
if command -v lspci >/dev/null 2>&1 && lspci | grep -qiE 'VGA.*Intel|3D.*Intel|Display.*Intel'; then
    export LIBVA_DRIVER_NAME=iHD
fi

# --- less & bat & fzf 环境变量 ---
export MANPAGER='less -q'
export LESS_TERMCAP_md=$'\E[01;34m'
export LESS_TERMCAP_me=$'\E[0m'
export LESS_TERMCAP_us=$'\E[01;32m'
export LESS_TERMCAP_ue=$'\E[0m'
export LESS_TERMCAP_so=$'\E[01;33;44m'
export LESS_TERMCAP_se=$'\E[0m'
export BAT_PAGER="less -RF"

# 使用 bat 和 eza
export FZF_CTRL_T_OPTS="--preview 'bat -n --color=always {}' --bind 'ctrl-/:change-preview-window(down|hidden|)'"
export FZF_ALT_C_OPTS="--preview 'eza --tree --color=always {}'"

# --- Homebrew 补全路径 (PATH 等已在 .zshenv 中设置) ---
if [ -n "$HOMEBREW_PREFIX" ] && [ -d "$HOMEBREW_PREFIX/share/zsh/site-functions" ]; then
    fpath=("$HOMEBREW_PREFIX/share/zsh/site-functions" $fpath)
fi

# -------------------- 2. Oh My Zsh 配置 (OMZ Configuration) --------------------

# --- Oh My Zsh 的安装路径 ---
if [ -d "$HOME/.oh-my-zsh" ]; then
    export ZSH="$HOME/.oh-my-zsh"
elif [ -d "/usr/share/oh-my-zsh" ]; then
    export ZSH="/usr/share/oh-my-zsh"
else
    echo "提示: 未检测到 Oh My Zsh 安装。"
fi

ZSH_THEME="" # Using Starship

# --- OMZ 插件列表 ---
# Only include plugins that are built-in to OMZ here
plugins=(
    git
    extract
    zsh-shift-select
)

# --- OS 检测 & 插件路径配置 ---
if [ -f /etc/os-release ]; then
    . /etc/os-release
    OS_ID=$ID
else
    OS_ID="unknown"
fi

if [ "$OS_ID" = "arch" ]; then
    ZSH_COMPLETIONS_DIR="/usr/share/zsh/plugins/zsh-completions/src"
    ZSH_AUTOSUGGESTIONS_FILE="/usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
    ZSH_SYNTAX_HIGHLIGHTING_FILE="/usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
else
    # 其他系统默认为手动 clone 路径
    ZSH_COMPLETIONS_DIR="${ZSH_CUSTOM:-$ZSH/custom}/plugins/zsh-completions/src"
    ZSH_AUTOSUGGESTIONS_FILE="${ZSH_CUSTOM:-$ZSH/custom}/plugins/zsh-autosuggestions/zsh-autosuggestions.plugin.zsh"
    ZSH_SYNTAX_HIGHLIGHTING_FILE="${ZSH_CUSTOM:-$ZSH/custom}/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.plugin.zsh"
fi

# 确保 zsh-completions 路径在 compinit 调用前被加入到 fpath 中
fpath=(
    $ZSH_COMPLETIONS_DIR(N)
    $fpath
)

# --- 历史记录配置 (History Configuration) ---
export HISTFILE="$HOME/.zsh_history"
export HISTSIZE=10000
export SAVEHIST=10000
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_REDUCE_BLANKS
setopt SHARE_HISTORY

# OMZ 配置变量 (必须在 source oh-my-zsh.sh 之前设置)
CASE_SENSITIVE="true"
HIST_STAMPS="yyyy-mm-dd"

if [ -f "$ZSH/oh-my-zsh.sh" ]; then
    source "$ZSH/oh-my-zsh.sh"
fi

# check system paths first, then fallback to OMZ custom paths (manual clone)

# -- zsh-autosuggestions --
if [ -f "$ZSH_AUTOSUGGESTIONS_FILE" ]; then
    source "$ZSH_AUTOSUGGESTIONS_FILE"
fi

